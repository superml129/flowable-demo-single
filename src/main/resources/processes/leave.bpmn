<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             id="Definitions_1"
             targetNamespace="http://flowable.org/bpmn">

    <process id="leaveProcess" name="请假申请流程" isExecutable="true">
        <startEvent id="startEvent1"></startEvent>
        <userTask id="managerAudit" name="经理审批" flowable:assignee="${manager}"></userTask>
        <endEvent id="endEvent1"></endEvent>
        <sequenceFlow id="flow1" sourceRef="startEvent1" targetRef="managerAudit"></sequenceFlow>
        <sequenceFlow id="flow2" sourceRef="managerAudit" targetRef="endEvent1"></sequenceFlow>
    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="leaveProcess">
            <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="startEvent1">
                <omgdc:Bounds x="150" y="120" width="36" height="36"></omgdc:Bounds>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="UserTask_1_shape" bpmnElement="managerAudit">
                <omgdc:Bounds x="280" y="100" width="100" height="80"></omgdc:Bounds>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_1_shape" bpmnElement="endEvent1">
                <omgdc:Bounds x="450" y="120" width="36" height="36"></omgdc:Bounds>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
                <omgdi:waypoint x="186" y="138"></omgdi:waypoint>
                <omgdi:waypoint x="280" y="138"></omgdi:waypoint>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
                <omgdi:waypoint x="380" y="138"></omgdi:waypoint>
                <omgdi:waypoint x="450" y="138"></omgdi:waypoint>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>